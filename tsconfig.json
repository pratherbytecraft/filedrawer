{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/main",
    "src/vendor",
    "src/shared",
    "src/bin",
    "src/scripts",
    "scripts",
    "test/unit",
    "test/support",
    "test/helper"
  ]
}
